# HerbChain backend — local development config.
# Copy to backend/.env (gitignored) and adjust. Every value has a safe dev
# default; see src/config/env.js for the full list of supported variables.

# ----- Server -----
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# ----- Database (Prisma + SQLite) -----
# Relative paths resolve from prisma/schema/. Create/refresh the DB with:
#   npm run db:push      (dev schema)
#   npm run migrate      (prisma migrate deploy)
#   npm run seed:fresh   (drop + reseed demo data)
DATABASE_URL=file:./herbchain.db

# ----- Auth (JWT) -----
SECRET_KEY=change-me-dev-secret
JWT_SECRET_KEY=change-me-dev-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=30d

# ----- QR ownership tokens -----
QR_SIGNING_KEY=change-me-dev-qr-signing-key
QR_TOKEN_TTL_DAYS=30
QR_TOKEN_BYTES=24
QR_TOKEN_PREFIX=hbc_

# ----- CORS / frontend -----
CORS_ORIGINS=*
FRONTEND_URL=http://localhost:3000

# ----- Background workers (set any to "false" to disable) -----
BLOCKCHAIN_WORKER_ENABLED=true
NOTIFICATION_WORKER_ENABLED=true
DOCUMENT_WORKER_ENABLED=true
ANALYTICS_WORKER_ENABLED=true

# ----- AI recognition -----
# mock | gemini | azure_custom_vision  (mock works offline, no keys needed)
RECOGNITION_PROVIDER=mock
RECOGNITION_TOP_K=3
# GEMINI_API_KEY=
# AZURE_CV_ENDPOINT=
# AZURE_CV_PREDICTION_KEY=

# ----- Notifications (stub captures messages in-memory) -----
SMS_PROVIDER=stub
PUSH_PROVIDER=stub
EMAIL_PROVIDER=stub

# ----- Ledger -----
# mock | external adapter
LEDGER_PROVIDER=mock
