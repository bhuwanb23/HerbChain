# HerbChain Backend Environment Variables

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///herbchain.db
# For PostgreSQL: postgresql://username:password@localhost/herbchain
# For MySQL: mysql://username:password@localhost/herbchain

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Configuration
API_PREFIX=/api/v1

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# External Services (Optional)
# IPFS_NODE_URL=http://localhost:5001
# CLOUD_STORAGE_BUCKET=herbchain-images
