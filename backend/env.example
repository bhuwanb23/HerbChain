# HerbChain Backend Environment Variables
# Copy this file to backend/.env and adjust values for local dev.

# ----- Flask -----
SECRET_KEY=change-me-flask-secret
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000

# ----- Database -----
# Default SQLite (file under backend/server/instance/herbchain.db).
DATABASE_URL=sqlite:///herbchain.db
# For PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/herbchain

# ----- Auth -----
# JWT signing key for user access/refresh tokens.
JWT_SECRET_KEY=change-me-jwt-secret

# ----- QR ownership tokens -----
# HMAC key used to sign QR payloads. KEEP SECRET. Rotating this invalidates
# every outstanding QR (every batch will need a new one minted before next scan).
QR_SIGNING_KEY=change-me-qr-secret

# ----- CORS -----
# Comma-separated list of origins, or "*" for any (local dev only).
CORS_ORIGINS=*

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Upload limits -----
MAX_CONTENT_LENGTH=16777216  # 16 MB

# ----- Weather provider (optional) -----
# Free key from https://openweathermap.org/api. If unset, the /api/v1/weather
# endpoint returns a deterministic stubbed payload so the demo still renders.
OPENWEATHER_API_KEY=

# ----- Recognition / AI -----
# top_k limit accepted by /api/v1/recognition/herbs (default 3, max 10).
RECOGNITION_TOP_K=3
