// ============================================================================
// IDENTITY — users and addresses
// ============================================================================

// One row per login account. Role is a code list on the user (hybrid model):
// the account carries the role; role-specific operational data lives in the
// per-role profile tables (FarmerProfile, TransporterProfile, LabProfile,
// ManufacturerProfile). Consumers, retailers, distributors and admins are
// plain users with no profile row.
//
// role: farmer | transporter | lab | manufacturer | consumer | retailer |
//       distributor | admin
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique // stored lowercased at write time
  phone          String?   @unique
  password_hash  String
  role           String // code list above
  locale         String    @default("en")
  avatar_asset_id String?  @unique // -> Asset.id (set via optional relation below)

  // identity/verification state
  email_verified_at DateTime?
  phone_verified_at DateTime?
  kyc_status      String    @default("none") // none | pending | verified | rejected
  is_active       Boolean   @default(true)
  last_login_at   DateTime?

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime? // soft delete (history-safe)

  avatar_asset  Asset?     @relation("UserAvatar", fields: [avatar_asset_id], references: [id], onDelete: SetNull)
  assets_owned  Asset[]    @relation("AssetOwner")
  addresses     Address[]

  // security / activity (defined across other domain files)
  sessions         Session[]
  api_keys         ApiKey[]
  audit_actions    AuditLog[]    @relation("AuditActor")
  device_tokens    DeviceToken[]
  notifications    Notification[]

  // per-role profile rows (1:1, domain files own the opposite side)
  farmer_profile       FarmerProfile?
  transporter_profile  TransporterProfile?
  lab_profile          LabProfile?
  manufacturer_profile ManufacturerProfile?
  distributor_profile  DistributorProfile?
  retailer_profile     RetailerProfile?

  // catalogue & farm data
  species_created    Species[]         @relation("SpeciesCurator")
  price_quotes       PriceQuote[]      @relation("PriceQuoter")
  crop_plans         CropPlan[]
  farm_activities    FarmActivity[]    @relation("FarmActivityActor")

  // supply chain (batches + events)
  batches_created       Batch[]       @relation("BatchFarmer")
  batches_held          Batch[]       @relation("BatchHolder")
  batch_events_actor    BatchEvent[]  @relation("EventActor")
  batch_events_from     BatchEvent[]  @relation("EventFrom")
  batch_events_to       BatchEvent[]  @relation("EventTo")

  // quality
  lab_reports LabReport[] @relation("LabReporter")

  // logistics & stock
  warehouses_owned Warehouse[]
  stock_movements  StockMovement[]

  // products & commerce
  products_manufactured Product[]          @relation("ProductManufacturer")
  product_lots_held     ProductLot[]      @relation("LotHolder")
  lot_events_actor      ProductLotEvent[] @relation("LotEventActor")
  lot_events_from       ProductLotEvent[] @relation("LotEventFrom")
  lot_events_to         ProductLotEvent[] @relation("LotEventTo")
  orders_buyer          PurchaseOrder[]    @relation("OrderBuyer")
  orders_seller         PurchaseOrder[]    @relation("OrderSeller")
  wallets               Wallet[]
  licenses              LicenseCert[]
  inspections_conducted Inspection[]       @relation("Inspector")
  support_tickets_created SupportTicket[]  @relation("TicketRequester")
  support_tickets_owned SupportTicket[]    @relation("TicketAssignee")

  @@index([role])
  @@index([is_active])
  @@map("users")
}

// Postal address records — any user can hold several, typed by use case.
// Referenced by parties, warehouses, invoices and regulatory documents.
model Address {
  id         String   @id @default(cuid())
  user_id    String
  kind       String   @default("registered") // registered | billing | shipping | warehouse
  line1      String
  line2      String?
  city       String
  state      String
  postal_code String?
  country    String   @default("IN")
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("addresses")
}
