// ============================================================================
// BLOCKCHAIN — proof anchors for trusted domain events.
// ----------------------------------------------------------------------------
// Phase 12 of the roadmap: only trusted, high-value events (batch created,
// transfer executed, certification issued, product created, batch linked)
// get anchored to a permissioned ledger. This table is the INDEX of what was
// anchored where: which domain event row, on which chain, with which
// transaction hash and block. The ledger itself lives off-DB; this row is the
// verifiable receipt. entity_type/entity_id point at the domain event row
// (batch_event, product_lot_event, audit_log) — polymorphic, no relation.
// status: pending | confirmed | failed
// ============================================================================

model BlockchainEvent {
  id          String   @id @default(cuid())
  anchor_code String // mirrored event kind for readability:
                     // BATCH_CREATED | TRANSFERRED | CERTIFIED | REJECTED |
                     // PRODUCT_CREATED | LINKED | SALE | …
  entity_type String // batch_event | product_lot_event | audit_log
  entity_id   String
  chain       String   @default("polygon") // polygon | ethereum | hyperledger | other
  tx_hash     String?  @unique // set once the anchor transaction is broadcast
  block_number Int?
  block_time  DateTime? // block timestamp, once confirmed
  status      String   @default("pending") // pending | confirmed | failed
  recorded_at DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([status])
  @@index([recorded_at])
  @@map("blockchain_events")
}
